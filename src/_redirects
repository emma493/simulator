# Cloudflare Pages redirects
# Serve assets directly
/assets/*   /assets/:splat   200
/cdn/*      /cdn/:splat      200
/api/*      /api/:splat      200

# Step routes - serve index.html for each step
/origin/    /origin/index.html  200
/style/     /style/index.html   200
/body/      /body/index.html    200
/breast/    /breast/index.html  200
/booty/     /booty/index.html   200
/face/      /face/index.html    200
/soul/      /soul/index.html    200
/summary/   /summary/index.html 200

# SPA fallback
/*          /index.html         200
